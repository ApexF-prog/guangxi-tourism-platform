# 本地开发密钥：此文件已被 .gitignore 排除，请勿提交到任何仓库。
# 部署时用环境变量覆盖 application.yml，参见 docs/SECURITY.md
spring:
  datasource:
    password: '<请填写你的DB_PASSWORD>'

gxtourism:
  jwt:
    secret: '<请填写你的JWT_SECRET>'
  ai:
    api-key: '<请填写你的AI_API_KEY>'
  alipay:
    merchant-private-key: '<请填写你的ALIPAY_MERCHANT_PRIVATE_KEY>'
    alipay-public-key: '<请填写你的ALIPAY_PUBLIC_KEY>'
